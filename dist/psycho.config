# i3psycho — Phase 0 (config-only prototype)
# Floating-first i3 on a bone-stock i3 binary. Drop in as ~/.config/i3/config.

set $mod Mod4
font pango:DejaVu Sans 10

# ---- the point: everything floats ----
for_window [tiling] floating enable
floating_modifier $mod
default_floating_border normal 2
focus_follows_mouse no

# blue is sacred — stock i3 palette, stated explicitly as spec
client.focused          #4c7899 #285577 #ffffff #2e9ef4 #285577
client.focused_inactive #333333 #5f676a #ffffff #484e50 #5f676a
client.unfocused        #333333 #222222 #888888 #292d2e #222222
client.urgent           #2f343a #900000 #ffffff #900000 #900000

# ---- minimize (Phase 0: scratchpad; psychod adds geometry restore later) ----
bindsym $mod+m move scratchpad
bindsym $mod+Shift+m scratchpad show

# ---- keyboard snapping: halves, maximize, center ----
bindsym $mod+Left  floating enable, resize set 50 ppt 100 ppt, move position 0 ppt 0 ppt
bindsym $mod+Right floating enable, resize set 50 ppt 100 ppt, move position 50 ppt 0 ppt
bindsym $mod+Up    floating enable, resize set 100 ppt 100 ppt, move position 0 ppt 0 ppt
bindsym $mod+Down  floating enable, resize set 62 ppt 62 ppt, move position center

# quarters: $mod+Ctrl+1..4 = TL TR BL BR
bindsym $mod+Ctrl+1 floating enable, resize set 50 ppt 50 ppt, move position 0 ppt 0 ppt
bindsym $mod+Ctrl+2 floating enable, resize set 50 ppt 50 ppt, move position 50 ppt 0 ppt
bindsym $mod+Ctrl+3 floating enable, resize set 50 ppt 50 ppt, move position 0 ppt 50 ppt
bindsym $mod+Ctrl+4 floating enable, resize set 50 ppt 50 ppt, move position 50 ppt 50 ppt

# tiling still exists, you monster
bindsym $mod+t floating toggle

# ---- standard i3 survival kit ----
bindsym $mod+Return exec i3-sensible-terminal
bindsym $mod+Shift+q kill
bindsym $mod+d exec --no-startup-id dmenu_run
bindsym $mod+f fullscreen toggle

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec i3-nagbar -t warning -m 'Exit i3psycho?' -B 'Yes' 'i3-msg exit'

bar {
    status_command i3status
    position bottom
    colors {
        background #000000
        statusline #ffffff
        separator  #666666
        focused_workspace  #4c7899 #285577 #ffffff
        inactive_workspace #333333 #222222 #888888
        urgent_workspace   #2f343a #900000 #ffffff
    }
}
